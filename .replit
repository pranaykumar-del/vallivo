run = "npm install && npm run build && npx vite preview --port 3000 --host 0.0.0.0"

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
run = ["sh", "-c", "npm install && npm run build && npx vite preview --port 3000 --host 0.0.0.0"]
deploymentTarget = "cloudrun"
